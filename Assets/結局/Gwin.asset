  endingTitle: "\u6CBB\u7406\u5C08\u5BB6"
  endingLines:
  - "\u4F60\u662F\u79E9\u5E8F\u7684\u7DE8\u7E54\u8005\uFF0C\u4E5F\u662F\u898F\u5247\u7684\u5EFA\u7BC9\u5E2B\u3002"
  - "\u6BCF\u4E00\u6B21\u653F\u7B56\u8F49\u5411\u3001\u6BCF\u4E00\u9805\u5BE9\u6838\u901A\u904E\uFF0C\u80CC\u5F8C\u90FD\u6709\u4F60\u7CBE\u5BC6\u7684\u8A08\u7B97\u8207\u51B7\u975C\u7684\u5224\u65B7\u3002\r\n"
  - "\u4EBA\u5011\u7A31\u4F60\u51B7\u9177\uFF0C\u56E0\u70BA\u4F60\u660E\u767D\u611F\u60C5\u6703\u8B93\u6C7A\u7B56\u504F\u96E2\u6700\u512A\u89E3\uFF1B\u4F46\u4F60\u4E5F\u6E05\u695A\uFF0C\u898F\u5247\u7684\u521D\u8877\u4E0D\u53EA\u662F\u6548\u7387\uFF0C\u66F4\u662F\u5B88\u8B77\u3002"
  - "\u9019\u5834\u52DD\u5229\u8B49\u660E\u4E86\u4F60\u7684\u6CBB\u7406\u80FD\u529B\u7121\u4EBA\u80FD\u53CA\uFF0C\u4F46\u7576\u6C23\u5019\u5287\u8B8A\u3001\u793E\u6703\u5931\u5E8F\u6642\uFF0C\u4EFB\u4F55\u5236\u5EA6\u90FD\u5C07\u9762\u81E8\u8003\u9A57\u3002"
  - " \u800C\u4F60\uFF0C\u5C07\u662F\u90A3\u500B\u6C7A\u5B9A\u898F\u5247\u662F\u5426\u4ECD\u80FD\u7DAD\u7E6B\u4E16\u754C\u7684\u4EBA\u3002"
  bgmClip: {fileID: 8300000, guid: a1bcb6dee87e027438f40bdf7f417e2a, type: 3}
