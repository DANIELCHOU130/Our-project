  endingTitle: "\u88AB\u6536\u7DE8\u7684\u526F\u624B(\u4F4E)"
  endingLines:
  - "\u4F60\u5728\u904A\u6232\u4E2D\u6C92\u6709\u8D70\u6975\u7AEF\uFF0C\u4E5F\u6C92\u6709\u5805\u5B88\u67D0\u4E00\u7A2E\u4FE1\u5FF5\u3002"
  - "\u4F60\u5728\u6BCF\u4E00\u6B21\u6289\u64C7\u4E2D\u9078\u64C7\u4E86\u300C\u5B89\u5168\u300D\u8207\u300C\u7A69\u59A5\u300D\uFF0C\u907F\u514D\u885D\u7A81\uFF0C\u4E5F\u907F\u514D\u627F\u64D4\u8CAC\u4EFB\u3002"
  - "\u7576\u516C\u53F8\u88AB\u4F75\u8CFC\u6642\uFF0C\u4F60\u6BEB\u4E0D\u7336\u8C6B\u5730\u63A5\u53D7\u4E86\u65B0\u9AD4\u7CFB\u7684\u5B89\u6392\u2014\u2014\u85AA\u6C34\u66F4\u9AD8\u3001\u98A8\u96AA\u66F4\u4F4E\uFF0C\u4EE3\u50F9\u53EA\u662F\u6C89\u9ED8\u3002"
  - "\u4F60\u653E\u68C4\u4E86\u5728\u8463\u4E8B\u6703\u4E0A\u63D0\u51FA\u4E0D\u540C\u610F\u898B\uFF0C\u4E5F\u4E0D\u518D\u70BA\u4EFB\u4F55\u6539\u9769\u7AD9\u53F0\u3002"
  - "\u66FE\u7D93\u7684\u7406\u5FF5\u88AB\u9396\u9032\u62BD\u5C5C\uFF0C\u66FE\u7D93\u7684\u76DF\u53CB\u4E00\u500B\u500B\u96E2\u958B\uFF0C\u4F60\u7684\u540D\u5B57\u518D\u4E5F\u4E0D\u6703\u51FA\u73FE\u5728\u4EFB\u4F55\u95DC\u65BC\u7406\u60F3\u8207\u6C38\u7E8C\u7684\u5C0D\u8A71\u4E2D\u3002"
  - "\u5728\u6B0A\u529B\u7684\u7248\u5716\u4E0A\uFF0C\u4F60\u4E0D\u518D\u662F\u73A9\u5BB6\uFF0C\u53EA\u662F\u4E00\u679A\u9806\u5F9E\u7684\u68CB\u5B50\uFF0C\u70BA\u7DAD\u6301\u73FE\u72C0\u9ED8\u9ED8\u8F49\u52D5\u9F52\u8F2A\uFF0C\u76F4\u5230\u88AB\u4E0B\u4E00\u5834\u4F75\u8CFC\u53D6\u4EE3\u3002"
  bgmClip: {fileID: 8300000, guid: fb1870d10e54eee42912443e1bad47f6, type: 3}
