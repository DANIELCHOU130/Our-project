  endingTitle: "\u7DA0\u8272\u6CBB\u7406\u8005"
  endingLines:
  - "\u4F60\u4EE5\u7DA0\u8272\u70BA\u4FE1\u4EF0\uFF0C\u5728\u5145\u6EFF\u6B0A\u8B00\u8207\u5229\u76CA\u7684\u68CB\u76E4\u4E0A\u95D6\u51FA\u4E00\u689D\u4E0D\u540C\u7684\u8DEF\u3002"
  - "\u5225\u4EBA\u8AAA\u74B0\u4FDD\u662F\u6210\u672C\uFF0C\u662F\u7D2F\u8D05\uFF0C\u662F\u5728\u7AF6\u722D\u4E2D\u653E\u6162\u8173\u6B65\u7684\u67B7\u9396\uFF1B\u4F60\u537B\u7528\u4E00\u6B21\u53C8\u4E00\u6B21\u7684\u884C\u52D5\uFF0C\u8B49\u660E\u5B83\u662F\u4E00\u7A2E\u529B\u91CF\u2014\u2014\u80FD\u626D\u8F49\u683C\u5C40\uFF0C\u80FD\u5F71\u97FF\u5236\u5EA6\uFF0C\u751A\u81F3\u80FD\u8D0F\u5F97\u52DD\u5229\u3002"
  - "\u5728\u88AB\u5EE2\u68C4\u7684\u5DE5\u5EE0\uFF0C\u4F60\u91CD\u555F\u4E86\u98A8\u529B\u767C\u96FB\u6A5F\uFF1B\u5728\u6C59\u6FC1\u7684\u6CB3\u53E3\uFF0C\u4F60\u7A2E\u4E0B\u4E86\u6D77\u8349\u8207\u5E0C\u671B\u3002"
  - "\u4F60\u7684\u6210\u529F\uFF0C\u8B93\u4E16\u4EBA\u77E5\u9053\u6C38\u7E8C\u4E0D\u662F\u53E3\u865F\uFF0C\u800C\u662F\u4E00\u7A2E\u53EF\u4EE5\u5275\u9020\u6536\u76CA\u3001\u4E5F\u80FD\u5B88\u8B77\u672A\u4F86\u7684\u7B56\u7565\u3002"
  - "\u4F46\u4F60\u6BD4\u8AB0\u90FD\u6E05\u695A\uFF0C\u9019\u5834\u904A\u6232\u53EA\u662F\u5E8F\u5E55\u3002\u672A\u4F86\u7684\u6311\u6230\uFF0C\u4F86\u81EA\u4E0B\u4E00\u500B\u6C92\u6709\u9AB0\u5B50\u3001\u6C92\u6709\u56DE\u5408\u3001\u6C92\u6709\u91CD\u4F86\u7684\u73FE\u5BE6\u4E16\u754C\u3002"
  bgmClip: {fileID: 8300000, guid: 95c5042e62ad04849959e59e9b990c2f, type: 3}
