  endingTitle: "\u6CBB\u7406\u6B98\u5F71\u8005(\u4F4E)"
  endingLines:
  - "\u4F60\u7528\u5236\u5EA6\u6500\u4E0A\u9AD8\u5CF0\uFF0C\u4E5F\u5728\u5236\u5EA6\u88E1\u589C\u843D\u3002"
  - "\u7576\u6B0A\u4F4D\u8207\u8CC7\u7522\u540C\u6642\u5D29\u584C\uFF0C\u4F60\u7684\u624B\u6BB5\u8207\u9670\u5F71\u88AB\u7FFB\u6AA2\u3001\u5BE9\u5224\uFF0C\u6210\u70BA\u5931\u6557\u8207\u8150\u6557\u7684\u6559\u79D1\u66F8\u3002"
  - "\u5931\u53BB\u521D\u8877\u7684\u4F60\uFF0C\u6700\u7D42\u4E5F\u88AB\u6B32\u671B\u541E\u566C\u3002"
  - "\u898F\u5247\u82E5\u5931\u53BB\u9053\u5FB7\uFF0C\u6700\u7D42\u4E5F\u53EA\u662F\u7A7A\u6CDB\u7684\u689D\u6587\uFF0C\u88AB\u6709\u5FC3\u4EBA\u5229\u7528\uFF0C\u6210\u70BA\u5277\u9664\u7570\u5DF1\u7684\u9053\u5177\u3002"
