  endingTitle: "\u88AB\u6536\u7DE8\u7684\u526F\u624B(\u9AD8)"
  endingLines:
  - "\u4F60\u9078\u64C7\u4E0D\u6975\u7AEF\uFF0C\u4E5F\u56E0\u6B64\u6C92\u6709\u6210\u70BA\u8D0F\u5BB6\u3002"
  - "\u6240\u5E78\u4F60\u7684\u52AA\u529B\u4E26\u4E0D\u662F\u767D\u8CBB\u529B\u6C23\uFF0C\u5728\u9019\u5834\u7AF6\u722D\u4E2D\u4F60\u5C55\u73FE\u7684\u5BE6\u529B\u88AB\u5176\u4ED6\u4EBA\u6240\u8A8D\u540C\u3002"
  - "\u5728\u88AB\u4F75\u8CFC\u5F8C\uFF0C\u4F60\u63A5\u53D7\u4E86\u65B0\u9AD4\u7CFB\u7684\u5B89\u6392\uFF0C\u6210\u70BA\u5176\u4E2D\u4E00\u500B\u4E2D\u5C64\u529B\u91CF\u3002"
  - "\u4F60\u5B88\u4F4F\u4E86\u80FD\u5B88\u7684\u90E8\u5206\uFF0C\u4E5F\u9ED8\u9ED8\u5F71\u97FF\u8457\u4ECD\u9858\u610F\u50BE\u807D\u7684\u4EBA\u3002"
  - "\u96D6\u7136\u4E0D\u518D\u4E3B\u5C0E\uFF0C\u4F46\u4F60\u4F9D\u820A\u662F\u7406\u5FF5\u7684\u5B88\u9580\u4EBA\u3002"
